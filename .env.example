# Copy to .env (never commit .env). Only the variable for the provider you use is needed.
# The default run replays the recorded ledger and needs no key at all.

# Override config/llm.toml without editing it, for example: openai:<model> or google:<model>
NORTHWIND_MODEL=

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
