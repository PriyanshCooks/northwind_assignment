# Copy this file to .env (never commit .env: it is gitignored). Only the variable for the provider you use is needed.
# The default run replays the recorded ledger and needs no key at all.

# Switch the model without editing config/llm.toml, for example openai:gpt-4o-mini. Leave empty for the local model.
NORTHWIND_MODEL=

# Paste your OpenAI key after the equals sign, on this line, with no quotes. It is read from the environment only
# and is never written to a ledger, a log or an error message.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
