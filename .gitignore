# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# runtime working files (disposable, rebuilt every run)
.northwind/

# secrets: never committed
.env

# generated output: only the folder marker is tracked until the first reviewed sample is committed
output/*
!output/.gitkeep

# frontend tooling, if a build step is ever added
node_modules/
frontend/dist/

# editors
.vscode/
.idea/
